<?php

/**
 * @file
 * Component Marking Decoder module.
 */

/**
 * Implements hook_theme().
 *
 * Registers the Twig template that renders the tool's mount point and its
 * server-rendered description.
 */
function tmwb_component_identifier_theme($existing, $type, $theme, $path) {
  return [
    'tmwb_component_identifier' => [
      'variables' => [
        'heading' => 'h2',
        'solo' => FALSE,
        'features' => [],
        'show_description' => TRUE,
      ],
      'template' => 'tmwb-component-identifier',
    ],
  ];
}
